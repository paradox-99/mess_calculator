# Copy this file to .env and fill in real values. Never commit the real .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Local Postgres — adjust user/password/db name to match what you created.
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://mess_user:mess_pass@localhost:5432/mess_manager

TIME_ZONE=Asia/Dhaka

